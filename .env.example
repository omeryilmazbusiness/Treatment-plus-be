APP_NAME=treatment-plus-be
APP_ENV=local
APP_VERSION=0.0.0
APP_URL=http://localhost:8080
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://treatment:treatment@localhost:5434/treatment_plus?sslmode=disable
DATABASE_APP_URL=postgres://treatment_app:treatment@localhost:5434/treatment_plus?sslmode=disable
DATABASE_RO_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2

REDIS_URL=redis://localhost:6380/0

# Phase 1 — local default is applied if empty. Production must set >=32 bytes.
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-min-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_REFRESH_SECRET=
INTERNAL_TOKEN=
KMS_KEY=local-dev-kms-key-must-be-at-least-32b

# Phase 5
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Phase 8
OPENAI_API_KEY=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=treatment-plus-api

# 3D mouth model. If empty, the API looks in internal/viz/player/static/mouth.glb
# then downloads from the public mouth-glb GitHub Release.
VIZ_MODEL=
VIZ_MODEL_URL=
